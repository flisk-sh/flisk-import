{
  "name": "flisk-import",
  "version": "0.8.0",
  "description": "Import a repository's root docker-compose.yml into Flisk service.json files, or register its Tiltfile.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flisk-import": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/flisk-import.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/flisk-sh/flisk-import#readme",
  "bugs": {
    "url": "https://github.com/flisk-sh/flisk-import/issues"
  }
}
